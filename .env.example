# Copy to `.env` (git-ignored). Used by api, web (Vite) and docker compose.

NODE_ENV=development

# ---- Ports ----
API_PORT=3000
WEB_PORT=4200
# Traefik gateway (docker compose)
HTTP_PORT=80

# ---- PostgreSQL (pgvector/pgvector:pg16) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASSWORD=postgres
# AWS RDS: set DB_SSL=true (optionally DB_SSL_CA_PATH to the RDS CA bundle)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=
# Run pending migrations on API start (handy in docker)
DB_MIGRATIONS_RUN=false

# ---- Redis 7 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0
# AWS ElastiCache in-transit encryption: REDIS_TLS=true
REDIS_TLS=false

# ---- OIDC (AWS Cognito) ----
# false = API does not verify tokens (local development only)
AUTH_ENABLED=false
# https://cognito-idp.<region>.amazonaws.com/<userPoolId>
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Cognito hosted UI domain, e.g. https://<prefix>.auth.<region>.amazoncognito.com (used for logout)
OIDC_COGNITO_DOMAIN=
# Space-separated; each must be enabled in the Cognito app client (Allowed OAuth scopes)
OIDC_SCOPE=openid email phone

# ---- LLM (Claude via LangChain) ----
# Anthropic-compatible endpoint, e.g. https://api.anthropic.com or a gateway URL
MODEL_BASE_URL=
MODEL_API_KEY=

# ---- MCP servers (remote tools for the agent) ----
# Called with the signed-in visitor's JWT (same Cognito client). Empty = server not used.
MCP_USER_URL=http://mcp-server/api/mcp/user
MCP_ASSET_URL=http://mcp-server/api/mcp/asset
MCP_LOCATION_URL=http://mcp-server/api/mcp/location
MCP_WORK_ORDER_URL=http://mcp-server/api/mcp/work-order
