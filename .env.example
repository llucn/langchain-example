# Copy to `.env` (git-ignored). Used by api, web (Vite) and docker compose.
# AWS deployment (`pnpm deploy:aws`) also reads AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# from here, plus the OIDC_*, MODEL_*, CONFIG_* keys below; see docs/aws-deployment.md.

NODE_ENV=development

# ---- Ports ----
API_PORT=3000
WEB_PORT=4200
# Traefik gateway (docker compose)
HTTP_PORT=80

# ---- PostgreSQL (pgvector/pgvector:pg16) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=postgres
DB_PASSWORD=postgres
# AWS RDS: set DB_SSL=true (optionally DB_SSL_CA_PATH to the RDS CA bundle)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=
# Run pending migrations on API start (handy in docker)
DB_MIGRATIONS_RUN=false

# ---- Redis 7 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0
# AWS ElastiCache in-transit encryption: REDIS_TLS=true
REDIS_TLS=false

# ---- OIDC (AWS Cognito) ----
# false = API does not verify tokens (local development only)
AUTH_ENABLED=false
# https://cognito-idp.<region>.amazonaws.com/<userPoolId>
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Cognito hosted UI domain, e.g. https://<prefix>.auth.<region>.amazoncognito.com (used for logout)
OIDC_COGNITO_DOMAIN=
# Space-separated; each must be enabled in the Cognito app client (Allowed OAuth scopes)
OIDC_SCOPE=openid email phone

# ---- LLM (Claude via LangChain) ----
# Anthropic-compatible endpoint, e.g. https://api.anthropic.com or a gateway URL
MODEL_BASE_URL=
MODEL_API_KEY=

# ---- Agent Config (agents, prompts, MCP servers, agent parameters) ----
# Read at startup from a GitHub repository through the GitHub API (no git binary needed); see
# docs/config-sample for the layout. The MCP server URLs live in the config's `mcpServers`.
# Repository URL, `//` and the folder inside it. A local directory works too (development).
CONFIG_SOURCE=https://github.com/llucn/config.git//langchain-example
# Branch, tag or commit ID. A tag/commit is immutable; a branch is picked up at the next start.
CONFIG_REF=v1.0
# Read-only token (Contents: Read) for a private repository
CONFIG_GITHUB_TOKEN=
# GitHub Enterprise Server only; default: https://api.github.com (github.com) or https://<host>/api/v3
CONFIG_GITHUB_API_URL=
# CONFIG_*, EVOLUTION_MODEL and EVOLUTION_MAX_TOKENS are defaults: admins can override them on the
# Settings page without a restart (stored overrides win). Base64 32-byte key (`openssl rand -base64 32`)
# that encrypts a GitHub token stored there; without it the token stays environment-only.
SETTINGS_ENCRYPTION_KEY=

# ---- Chat logging / admin ----
# Cognito group whose members may use Log Review (default: admin)
ADMIN_GROUP=admin
# Version written to chat logs (default: version of apps/api/package.json)
APP_VERSION=

# ---- Improvement proposals (diagnosis and proposal agents) ----
# Model of the improvement agents; connection is MODEL_BASE_URL / MODEL_API_KEY (or the config's model block)
EVOLUTION_MODEL=claude-sonnet-5-5
EVOLUTION_MAX_TOKENS=8192
