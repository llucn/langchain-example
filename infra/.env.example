# Optional: copy to infra/.env.dev (git-ignored) to override or add deploy settings.
# Precedence: real environment variables > infra/.env.<stage> > the repository root .env.
# From the root .env only these keys are read: AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# OIDC_*, MODEL_*, CONFIG_*, ADMIN_GROUP, EVOLUTION_*, APP_VERSION. Local DB_*, REDIS_*, NODE_ENV and
# AUTH_ENABLED are never sent to AWS.

# ---- AWS CLI credentials (normally in the root .env) ----
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Required ----
# Cognito issuer and app client; also baked into the web build.
# Register `<CloudFront URL>/` as callback URL and sign-out URL (printed after deploy).
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Written to AWS Secrets Manager by `pnpm deploy:aws`.
MODEL_API_KEY=
CONFIG_GITHUB_TOKEN=

# ---- Optional (copied to the Elastic Beanstalk environment when non-empty) ----
# Same names/meaning as /.env.example:
#   OIDC_COGNITO_DOMAIN, OIDC_SCOPE, ADMIN_GROUP, MODEL_BASE_URL, CONFIG_SOURCE, CONFIG_REF,
#   CONFIG_GITHUB_API_URL, EVOLUTION_MODEL, EVOLUTION_MAX_TOKENS, APP_VERSION
# NOT supported on purpose: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (the instance role is used).

# Only if the AWS credentials cannot call ec2:DescribeManagedPrefixLists: id of the managed prefix
# list com.amazonaws.global.cloudfront.origin-facing in your region.
# CLOUDFRONT_PREFIX_LIST_ID=
# Deliberate Elastic Beanstalk platform override (replaces the environment).
# EB_SOLUTION_STACK=
